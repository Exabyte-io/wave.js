{
    "extends": ["@exabyte-io/eslint-config"],
    "settings": {
        "import/resolver": {
            "node": {
                "extensions": [".js", ".jsx", ".ts", ".tsx"]
            }
        }
    },
    "globals": {
        "jest": "readonly"
    },
    "rules": {
        // To avoid "Missing return type on function"
        "@typescript-eslint/explicit-module-boundary-types": "off"
    }
}
